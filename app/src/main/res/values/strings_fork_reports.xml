    <!-- What moves your Recovery: each habit's change in HRV the morning after, how sure it is, and what it came with. -->
    <string name="fork_rep_effects">What moves your Recovery</string>
    <string name="fork_rep_on_hrv">On HRV, last 60 days</string>
    <string name="fork_rep_percent_up">+<xliff:g id="percent" example="7">%1$d</xliff:g>%%</string>
    <string name="fork_rep_percent_down">−<xliff:g id="percent" example="7">%1$d</xliff:g>%%</string>
    <plurals name="fork_rep_effect_clear" tools:ignore="ImpliedQuantity">
        <item quantity="one">Clear, over <xliff:g id="mornings" example="1">%1$d</xliff:g> morning</item>
        <item quantity="other">Clear, over <xliff:g id="mornings" example="20">%1$d</xliff:g> mornings</item>
    </plurals>
    <plurals name="fork_rep_effect_likely" tools:ignore="ImpliedQuantity">
        <item quantity="one">Likely, over <xliff:g id="mornings" example="1">%1$d</xliff:g> morning</item>
        <item quantity="other">Likely, over <xliff:g id="mornings" example="9">%1$d</xliff:g> mornings</item>
    </plurals>
    <!-- After the effect's line: the habit it most often came with, in lower case ("late workout"). -->
    <string name="fork_rep_effect_along"><xliff:g id="effect" example="Likely, over 9 mornings">%1$s</xliff:g>, often with <xliff:g id="habit" example="late workout">%2$s</xliff:g></string>
    <!-- Lists of habits, in lower case after the first. -->
    <string name="fork_rep_effect_none">No clear effect: <xliff:g id="habits" example="weekend night, short night and hard day">%1$s</xliff:g>.</string>
