<!--
  The fork's reports and journal (jptorres-emp/openstrap): the Reports page from the You page, with today's ideal
  effort, the week and the month against the stretch before, and the habits' effect on the next morning, and the
  journal sheet (ui/glow/ReportsPage.kt, ui/device/JournalSheet.kt). Translated into Portuguese only.
-->
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" tools:ignore="MissingTranslation">
