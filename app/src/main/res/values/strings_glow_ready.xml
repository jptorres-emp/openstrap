<?xml version="1.0" encoding="utf-8"?>
<!--
  Starting a workout: Choose (the sports, search and your usual) and Ready (the goal and plan cards), in
  ui/glow/ChooseScreen.kt, ReadyScreen.kt, ReadyCardio.kt and ReadyPlans.kt. The sport names and the rest of Ready's
  words come from the workout copy.
-->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Choose's page title, beside the close button. One line. -->
    <string name="glow_choose_title">Start a workout</string>
    <!-- Choose's search field before it's tapped, and the search page's field hint. -->
    <string name="glow_choose_search_all">Search all sports</string>
    <!-- A section label over the sports used lately, as chips or tiles. -->
    <string name="glow_choose_recent">Recent</string>
    <!-- A section label over the everyday sports' tiles on Choose, and the search page's line before anything is typed. -->
    <string name="glow_choose_all_sports">All sports</string>
    <!-- Over the sport most often started, in a slim row on Choose. -->
    <string name="glow_choose_your_usual">Your usual</string>
    <!-- The button at the end of Your usual that starts that sport straight away. One short word. -->
    <string name="glow_choose_start">Start</string>
    <!-- Spoken for the small location mark on a sport's tile that is only done outdoors, for screen readers. -->
    <string name="glow_choose_outdoors">Outdoors</string>
    <string name="glow_ready_hero_zone_range"><xliff:g id="low" example="2">%1$d</xliff:g> to <xliff:g id="high" example="3">%2$d</xliff:g></string>
    <string name="glow_ready_last_caption">Last time, <xliff:g id="day" example="Tue">%1$s</xliff:g></string>
    <string name="glow_ready_last_today">today</string>
    <string name="glow_ready_last_time">Time</string>
    <string name="glow_ready_last_distance">Distance</string>
    <string name="glow_ready_last_pace">Avg pace</string>
    <string name="glow_ready_last_avg_bpm">Avg bpm</string>
    <string name="glow_ready_last_peak_bpm">Peak bpm</string>
    <string name="glow_ready_last_kcal">Active kcal</string>
    <string name="glow_ready_last_load">Load</string>
    <string name="glow_ready_last_sets">Sets</string>
    <string name="glow_choose_change_title">Change sport</string>
    <string name="glow_choose_now">Now</string>
    <string name="glow_choose_now_note">Your goal carries over if it fits</string>
    <string name="glow_choose_pick_title">Choose a sport</string>
    <!-- The sport picker's search field hint. One short word. -->
    <string name="glow_choose_search">Search</string>
    <!-- Section titles over the sports on Choose a sport, Change sport and Search. One line each. -->
    <string name="glow_choose_group_distance">Distance</string>
    <string name="glow_choose_group_indoor">Indoor cardio</string>
    <string name="glow_choose_group_strength">Strength and intervals</string>
    <string name="glow_choose_group_mind">Mind and body</string>
    <string name="glow_choose_group_games">Games</string>
    <string name="glow_choose_group_other">Other</string>
    <!-- The line under each section title: what its sports record. One line each. -->
    <string name="glow_choose_group_distance_note">Route, distance and pace</string>
    <string name="glow_choose_group_indoor_note">Time, heart rate and calories</string>
    <string name="glow_choose_group_strength_note">Sets, rounds and rest</string>
    <string name="glow_choose_group_mind_note">Calm heart rate and time</string>
    <string name="glow_choose_group_games_note">Time, heart rate and effort</string>
    <string name="glow_choose_group_other_note">Anything else, time and heart rate</string>
    <!-- When the search finds nothing. The query is what was typed, in quotes. -->
    <string name="glow_choose_no_match">No sport called <xliff:g id="v1" example="x">%1$s</xliff:g></string>
    <!-- Spoken for the X at the end of the search field that clears it, for screen readers. -->
    <string name="glow_choose_clear">Clear</string>
    <!-- Over the search results: how many sports match what's typed. -->
    <plurals name="glow_choose_sports_count">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> sport</item>
        <item quantity="other"><xliff:g id="count" example="12">%d</xliff:g> sports</item>
    </plurals>

    <!-- Ready, under the close button, when you disconnected the strap: it stays disconnected until you connect it. -->
    <string name="glow_ready_strap_disconnected">Strap disconnected, no live heart rate</string>
    <!-- Ready's button that connects the strap you disconnected. -->
    <string name="glow_ready_connect">Connect strap</string>
    <!-- Ready's heart card beside the live heart rate drawn large. -->
    <!-- Spoken for the plan pill on Ready, for screen readers: the plan's name, then what tapping it does. -->
    <!-- The sheet's title when saving intervals by name: the button's words ("Save intervals") and the intervals ("5 × 400 m"). -->

    <!--
      The plan cards lay a typed number out among words, a number drawn large then words beside it: "5 × 400 m" over
      "with [90 s] rest between". Each piece stands on its own beside a number, so keep them short.
    -->
</resources>
