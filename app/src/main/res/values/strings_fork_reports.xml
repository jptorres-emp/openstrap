    <string name="fork_rep_plan_fits_two">A usual day of <xliff:g id="sport" example="football">%1$s</xliff:g> fits (≈&#160;<xliff:g id="load" example="142">%2$d</xliff:g>), or one of <xliff:g id="other" example="CrossFit">%3$s</xliff:g> (≈&#160;<xliff:g id="other_load" example="120">%4$d</xliff:g>).</string>
    <string name="fork_rep_plan_over">A usual day of <xliff:g id="sport" example="football">%1$s</xliff:g> (≈&#160;<xliff:g id="load" example="142">%2$d</xliff:g>) goes over the target: keep it lighter.</string>
    <string name="fork_rep_plan_under">A usual day of <xliff:g id="sport" example="football">%1$s</xliff:g> (≈&#160;<xliff:g id="load" example="142">%2$d</xliff:g>) stays under the target: room to go harder.</string>
