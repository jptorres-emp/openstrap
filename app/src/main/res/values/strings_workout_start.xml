<?xml version="1.0" encoding="utf-8"?>
<!--
  Starting a workout: the Choose page and the Ready page, with its plan, goal and where rows and their sheets
  (ui/workout/StartCopy.kt). The strap is the Helio Strap the app records with. Tabata is the name of a workout, keep it
  unless your language has its own. Units (km, m, min, s, h, bpm) read as the app writes them elsewhere.
-->
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Choose's one line about the strap, when it's connected and reads a heart rate. One line. -->
    <string name="workout_start_strap_ready_bpm">Strap ready, <xliff:g id="bpm" example="72">%1$d</xliff:g> bpm</string>
    <!-- Choose's strap line when it's connected but no heart rate has come yet. -->
    <string name="workout_start_strap_ready">Strap ready</string>
    <!-- Choose's strap line while the app connects to it. -->
    <string name="workout_start_strap_connecting">Connecting to the strap</string>
    <!-- Choose's strap line with no strap paired. A workout records from the phone alone. -->
    <string name="workout_start_strap_not_paired">No strap paired, start anyway</string>
    <!-- Choose's strap line when the paired strap isn't connected. -->
    <string name="workout_start_strap_not_connected">Strap not connected, start anyway</string>

    <!-- The goal chip for no goal on a run. A short chip, about 12 characters. -->
    <string name="workout_start_just_run">Just run</string>
    <!-- The goal chip for no goal on a walk. A short chip. -->
    <string name="workout_start_just_walk">Just walk</string>
    <!-- The goal chip for no goal on a bike ride. A short chip. -->
    <string name="workout_start_just_ride">Just ride</string>
    <!-- The goal chip for no goal on rowing. A short chip. -->
    <string name="workout_start_just_row">Just row</string>
    <!-- The goal chip for no goal on any other sport. A short chip. -->
    <string name="workout_start_just_go">Just go</string>


    <!-- Strength's plan kind with a set number of sets, in its sheet. One word. -->
    <string name="workout_start_strength_plan">Plan</string>
    <!-- Strength's note with open sets. -->
    <string name="workout_start_open_sets_note">No set limit, a buzz when rest is over</string>
    <!-- A count of sets: a preset chip ("5 sets") and in "Last time 5 sets, Tuesday". -->
    <plurals name="workout_start_sets">
        <item quantity="one"><xliff:g id="count" example="1">%d</xliff:g> set</item>
        <item quantity="other"><xliff:g id="count" example="5">%d</xliff:g> sets</item>
    </plurals>
    <!-- A switch: rest ends once the heart rate is low enough. One line. -->
    <string name="workout_start_end_rest_early">End rest early</string>
    <!-- Under End rest early: the heart rate it ends at. -->
    <string name="workout_start_end_rest_note">Once you\'re under <xliff:g id="bpm" example="110">%1$d</xliff:g> bpm</string>
    <!-- A switch: a card after each set to note its reps and weight. One line. -->
    <string name="workout_start_log_sets">Log reps and weight</string>
    <!-- Under Log reps and weight. -->
    <string name="workout_start_log_sets_note">A quick card after each set</string>

    <!-- Ready's line for a game in free play: the strap records on its own. -->
    <string name="workout_start_games_status">Phone can stay in your bag</string>
    <!-- Ready's line for a game in halves with half time between. -->
    <string name="workout_start_games_note_half_break">The strap buzzes each half and break</string>
    <!-- Ready's line for a game in halves with no break. -->
    <string name="workout_start_games_note_half">The strap buzzes each half</string>
    <!-- Ready's line for a game in quarters with breaks. -->
    <string name="workout_start_games_note_quarter_break">The strap buzzes each quarter and break</string>
    <!-- Ready's line for a game in quarters with no breaks. -->
    <string name="workout_start_games_note_quarter">The strap buzzes each quarter</string>
    <!-- Ready's line for a game in periods with breaks. -->
    <string name="workout_start_games_note_period_break">The strap buzzes each period and break</string>
    <!-- Ready's line for a game in periods with no breaks. -->
    <string name="workout_start_games_note_period">The strap buzzes each period</string>


    <!-- A time in seconds, for a rest or a round: "90 s". -->
    <string name="workout_start_seconds"><xliff:g id="seconds" example="90">%1$d</xliff:g> s</string>
    <!-- A time in minutes: "2 min", a time preset, a rep or the minutes of last time's workout. -->
    <string name="workout_start_minutes"><xliff:g id="minutes" example="2">%1$d</xliff:g> min</string>
    <!-- A time in minutes and seconds: "2 min 30 s". -->
    <string name="workout_start_minutes_seconds"><xliff:g id="minutes" example="2">%1$d</xliff:g> min <xliff:g id="seconds" example="30">%2$d</xliff:g> s</string>
    <!-- A time preset of whole hours: "1 h". A short chip. -->
    <string name="workout_start_hours"><xliff:g id="hours" example="1">%1$d</xliff:g> h</string>
    <!-- A time preset of hours and minutes, as every duration in the app reads: "1 h 30". A short chip. -->
    <string name="workout_start_hours_minutes"><xliff:g id="hours" example="1">%1$d</xliff:g> h <xliff:g id="minutes" example="30">%2$d</xliff:g></string>
    <!-- A distance in kilometres, the number as typed: "2.4 km". -->
    <string name="workout_start_km"><xliff:g id="km" example="2.4">%1$s</xliff:g> km</string>
    <!-- A distance in metres: "400 m". -->
    <string name="workout_start_meters"><xliff:g id="meters" example="400">%1$d</xliff:g> m</string>
    <!-- The unit kilometres, beside a number drawn on its own. -->
    <string name="workout_start_unit_km">km</string>
    <!-- The unit metres, beside a number drawn on its own. -->
    <string name="workout_start_unit_m">m</string>
    <!-- The unit minutes, beside a number drawn on its own. -->
    <string name="workout_start_unit_min">min</string>
    <!-- The unit seconds, beside a number drawn on its own. -->
    <string name="workout_start_unit_s">s</string>

    <!-- HIIT's preset named after its inventor: 20 seconds of work, 10 of rest, 8 rounds. -->
    <string name="workout_start_preset_tabata">Tabata</string>
    <!-- HIIT's preset of 40 seconds of work and 20 of rest. A pill. -->
    <string name="workout_start_preset_forty_twenty">40 / 20</string>
    <!-- HIIT's preset where a round starts every minute: work, then rest for what's left of the minute. A pill. -->
    <string name="workout_start_every_minute">Every minute</string>
    <!-- Timed rounds by name: seconds of work and of rest, then the rounds. -->
    <plurals name="workout_start_structure_timed">
        <item quantity="one"><xliff:g id="work" example="30">%1$d</xliff:g> / <xliff:g id="rest" example="15">%2$d</xliff:g>, <xliff:g id="rounds" example="6">%3$d</xliff:g> round</item>
        <item quantity="other"><xliff:g id="work" example="30">%1$d</xliff:g> / <xliff:g id="rest" example="15">%2$d</xliff:g>, <xliff:g id="rounds" example="6">%3$d</xliff:g> rounds</item>
    </plurals>
    <!-- Rounds that start every so often, by name. -->
    <plurals name="workout_start_structure_every">
        <item quantity="one">Every <xliff:g id="time" example="90 s">%1$s</xliff:g>, <xliff:g id="rounds" example="10">%2$d</xliff:g> round</item>
        <item quantity="other">Every <xliff:g id="time" example="90 s">%1$s</xliff:g>, <xliff:g id="rounds" example="10">%2$d</xliff:g> rounds</item>
    </plurals>
    <!-- Run intervals by name: how many reps of what length. -->
    <string name="workout_start_structure_reps"><xliff:g id="reps" example="6">%1$d</xliff:g> × <xliff:g id="length" example="400 m">%2$s</xliff:g></string>
    <!-- HIIT's note with no timer. -->
    <string name="workout_start_hiit_free_note">No timer, laps mark the rounds</string>
    <!-- A switch: warm up before the rounds start. One line. -->
    <string name="workout_start_warm_up">Warm up first</string>
    <!-- Under Warm up first. -->
    <string name="workout_start_warm_up_note">No timer until the rounds start</string>

    <!-- A game played in two halves. A pill. -->
    <string name="workout_start_halves">Halves</string>
    <!-- A game played in four quarters. A pill. -->
    <string name="workout_start_quarters">Quarters</string>
    <!-- A game played in another number of periods. A pill. -->
    <plurals name="workout_start_periods">
        <item quantity="one"><xliff:g id="count" example="3">%1$d</xliff:g> period</item>
        <item quantity="other"><xliff:g id="count" example="3">%1$d</xliff:g> periods</item>
    </plurals>
    <!-- The first half of a game: on the live screen under its clock and on the summary. About 12 characters. -->
    <string name="workout_start_half_1">1st half</string>
    <!-- The second half of a game. About 12 characters. -->
    <string name="workout_start_half_2">2nd half</string>
    <!-- The first quarter of a game. About 12 characters. -->
    <string name="workout_start_quarter_1">1st quarter</string>
    <!-- The second quarter of a game. About 12 characters. -->
    <string name="workout_start_quarter_2">2nd quarter</string>
    <!-- The third quarter of a game. About 12 characters. -->
    <string name="workout_start_quarter_3">3rd quarter</string>
    <!-- The fourth quarter of a game. About 12 characters. -->
    <string name="workout_start_quarter_4">4th quarter</string>
    <!-- A game's period by its number. About 12 characters. -->
    <string name="workout_start_period_n">Period <xliff:g id="number" example="2">%1$d</xliff:g></string>
    <!-- The break between two halves, and the button that starts it. A button, about 12 characters. -->
    <string name="workout_start_half_time">Half time</string>
    <!-- The break between quarters or periods, and the button that starts it. A button, about 12 characters. -->
    <string name="workout_start_break">Break</string>

    <!-- Ready's line for mind and body with no length. -->
    <string name="workout_start_mind_open_note">Quiet strap, end it when you\'re ready</string>

    <!-- Your usual workout's line on Choose: what you did and the day. The what is "5.21 km", "5 sets" or "30 min", the day "Tuesday", "yesterday" or "Fri 23 Oct". -->
    <string name="workout_start_last_time">Last time <xliff:g id="what" example="5.21 km">%1$s</xliff:g>, <xliff:g id="day" example="Tuesday">%2$s</xliff:g></string>
    <!-- Ready's start button on a treadmill. A button. -->


    <!-- A goal kind in the goal pill and its sheet. One word. -->
    <string name="workout_start_kind_distance">Distance</string>
    <!-- A goal kind in the goal pill and its sheet. One word. -->
    <string name="workout_start_kind_time">Time</string>
    <!-- A goal kind: stay in a heart rate zone. One word. -->
    <string name="workout_start_kind_zone">Zone</string>
    <!-- A goal kind: run intervals. One word. -->
    <string name="workout_start_kind_intervals">Intervals</string>
    <!-- The note with no goal, for a sport that records a distance. -->
    <string name="workout_start_no_goal_note_distance">Records your time, distance and heart rate</string>
    <!-- The note with no goal, for a sport without a distance. -->
    <string name="workout_start_no_goal_note">Records your time and heart rate</string>
    <!-- A distance goal's note. The number is in kilometres, as typed. -->
    <string name="workout_start_distance_note">A buzz at halfway and at <xliff:g id="v1" example="x">%1$s</xliff:g> km</string>
    <!-- A time goal's note: when it would end if started now. -->
    <string name="workout_start_ends_near">Ends about <xliff:g id="time" example="19:15">%1$s</xliff:g></string>
    <!-- How the zone buttons work. -->
    <string name="workout_start_zone_note">Tap a zone, or two for a range</string>

    <!-- What run intervals of a distance do. The rep is "400 m", the total "2.4 km" or "800 m". -->
    <string name="workout_start_intervals_note_distance">A buzz each <xliff:g id="v1" example="x">%1$s</xliff:g> rep, <xliff:g id="v2" example="x">%2$s</xliff:g> in all</string>
    <!-- What run intervals of a time do. The rep is "4 min", the total "16 min" or "1 h 15". -->
    <string name="workout_start_intervals_note_time">A buzz each <xliff:g id="v1" example="x">%1$s</xliff:g> rep, <xliff:g id="v2" example="x">%2$s</xliff:g> in all</string>

    <!-- A switch on Ready: the strap asks to end the workout when you stop moving. One line. -->
    <string name="workout_start_ask_to_end">Ask to end when I stop</string>
    <!-- Under Ask to end when I stop. -->
    <string name="workout_start_ask_to_end_note">A buzz after 8 min without moving</string>
    <!-- A button when the phone's location is off. -->
    <string name="workout_start_turn_on_location">Turn on location</string>

    <!-- Ready's hero title with the strap connected. One line, large. -->
    <string name="workout_ready_connected">Strap connected</string>
    <!-- Ready's hero line under it while the heart rate comes in. -->
    <string name="workout_ready_live">Live from your strap</string>
    <!-- Ready's hero line while no heart rate has come yet. -->
    <string name="workout_ready_waiting">Waiting for heart rate</string>
    <!-- Ready's hero line while the heart rate comes in and the strap's battery is low. -->
    <string name="workout_ready_live_battery">Live from your strap, battery <xliff:g id="v1" example="5">%1$d</xliff:g>%%</string>
    <!-- Ready's hero line while no heart rate has come yet and the strap's battery is low. -->
    <string name="workout_ready_waiting_battery">Waiting for heart rate, battery <xliff:g id="v1" example="5">%1$d</xliff:g>%%</string>
    <!-- Ready's hero title while the app connects to the strap. One line, large. -->
    <string name="workout_ready_connecting">Connecting to the strap</string>
    <!-- Ready's hero title with no strap paired. One line, large. -->
    <string name="workout_ready_not_paired">No strap paired</string>
    <!-- Ready's hero title when the paired strap isn't connected. One line, large. -->
    <string name="workout_ready_not_connected">Strap not connected</string>
    <!-- Ready's hero line under any of the three above: a workout records from the phone alone. -->
    <string name="workout_ready_anyway">You can start anyway</string>
</resources>
