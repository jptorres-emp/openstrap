<?xml version="1.0" encoding="utf-8"?>
<!-- The recovery widget's picker preview card (widgets spec 6.4): the edge card's black, lit from the left in its ink. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0A0B" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="0" android:type="linear"
                android:startColor="#617CF2C9" android:centerColor="#147CF2C9" android:endColor="#007CF2C9" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
