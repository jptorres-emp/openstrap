    <string name="fork_rep_vs">vs <xliff:g id="before" example="49 ms">%1$s</xliff:g></string>
    <!-- How much a bedtime or a waking varies from night to night, in minutes, now and before. -->
    <string name="fork_rep_varies">Varies by <xliff:g id="now" example="44">%1$d</xliff:g> min, vs <xliff:g id="before" example="31">%2$d</xliff:g></string>
    <string name="fork_rep_varies_alone">Varies by <xliff:g id="now" example="44">%1$d</xliff:g> min</string>
    <!-- Under a count of workouts or sessions: their time, then how many there were before. -->
    <string name="fork_rep_time_line"><xliff:g id="time" example="4 h 15">%1$s</xliff:g> in all, vs <xliff:g id="before" example="3">%2$d</xliff:g></string>
    <string name="fork_rep_time_line_alone"><xliff:g id="time" example="4 h 15">%1$s</xliff:g> in all</string>

