<?xml version="1.0" encoding="utf-8"?>
<!--
  The fork's reports and journal (jptorres-emp/openstrap): the Reports page from the You page, with the week and the
  month against the stretch before, today's Load target and bedtime, the days of the week, the sports and what moves
  your Recovery, and the journal sheet (ui/glow/ReportsPage.kt, ui/device/JournalSheet.kt). Translated into
  Portuguese only.
-->
<resources xmlns:tools="http://schemas.android.com/tools" xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2" tools:ignore="MissingTranslation">
    <!-- The You page's rows that open the reports and the journal, and what they say under their names. -->
    <string name="fork_reports_row">Reports</string>
    <string name="fork_reports_row_line">Week, month, today\'s effort and habits</string>
    <string name="fork_journal_row">Journal</string>
    <string name="fork_journal_line_open">Yesterday\'s to fill in</string>
    <string name="fork_journal_line_done">Yesterday\'s filled in</string>

    <!-- The Reports page: its title, what the (i) says to a screen reader, while it's worked out, and the two stretches. -->
    <string name="fork_reports_title">Reports</string>
    <string name="fork_reports_about">About the reports</string>
    <string name="fork_reports_loading">Working out your reports</string>
    <string name="fork_rep_week">Week</string>
    <string name="fork_rep_month">Month</string>

    <!-- The (i) sheet: how each part is worked out. -->
    <string name="fork_rep_info_title">How the reports work</string>
    <string name="fork_rep_info_stretch_title">Week and month</string>
    <string name="fork_rep_info_stretch">The week is the last 7 days against the 3 weeks before, a week on average. The month is the last 30 days against the 30 before.</string>
    <string name="fork_rep_info_target">Today\'s Load target comes from your own training days in the last 6 weeks, or from your usual Load until there are 4 of them. Recovery says what the day is for.</string>
    <string name="fork_rep_info_bedtime">Bedtime tonight is the sleep you need, plus some for the last week\'s short nights, before your usual waking, at your usual time asleep against time in bed.</string>
    <string name="fork_rep_info_habits">What moves your Recovery compares your HRV on the mornings after a day with each habit against the mornings after a day without it, over the last 60 days. A permutation test says how sure that is.</string>

    <!-- The hero: the stretch's average Recovery, what it averages, and the Load a day beside it. -->
    <string name="fork_rep_hero_week">Average, last 7 days</string>
    <string name="fork_rep_hero_month">Average, last 30 days</string>
    <string name="fork_rep_hero_load">Load a day</string>
    <string name="fork_rep_hero_none">No Recovery in these days yet</string>

    <!-- The Recovery chart: its title, and your normal (the middle half of your mornings) as its note. -->
    <string name="fork_rep_recovery">Recovery</string>
    <string name="fork_rep_normal">Your normal, <xliff:g id="low" example="69">%1$d</xliff:g> to <xliff:g id="high" example="77">%2$d</xliff:g></string>

    <!-- The sentence under the chart: Recovery against the stretch before (fork_rep_before_week or _month), then the Load. -->
    <string name="fork_rep_sentence_up">Recovery averaged <xliff:g id="average" example="74">%1$d</xliff:g>, <xliff:g id="change" example="2">%2$d</xliff:g> up on <xliff:g id="before" example="the 3 weeks before">%3$s</xliff:g>.</string>
    <string name="fork_rep_sentence_down">Recovery averaged <xliff:g id="average" example="74">%1$d</xliff:g>, <xliff:g id="change" example="2">%2$d</xliff:g> down on <xliff:g id="before" example="the 3 weeks before">%3$s</xliff:g>.</string>
    <string name="fork_rep_sentence_same">Recovery averaged <xliff:g id="average" example="74">%1$d</xliff:g>, the same as <xliff:g id="before" example="the 3 weeks before">%2$s</xliff:g>.</string>
    <string name="fork_rep_sentence_alone">Recovery averaged <xliff:g id="average" example="74">%1$d</xliff:g>.</string>
    <string name="fork_rep_before_week">the 3 weeks before</string>
    <string name="fork_rep_before_month">the 30 days before</string>
    <string name="fork_rep_load_higher">Your Load was <xliff:g id="percent" example="36">%1$d</xliff:g>%% higher.</string>
    <string name="fork_rep_load_lower">Your Load was <xliff:g id="percent" example="12">%1$d</xliff:g>%% lower.</string>
    <string name="fork_rep_load_same">Your Load was about the same.</string>

    <!-- The Today card: Recovery, the Load target and tonight's bedtime, each with what it means under its name. -->
    <string name="fork_rep_today">Today</string>
    <string name="fork_rep_from_strap">The strap\'s score, while yours learns</string>
    <string name="fork_rep_target">Load target</string>
    <string name="fork_rep_target_value"><xliff:g id="low" example="110">%1$d</xliff:g> to <xliff:g id="high" example="205">%2$d</xliff:g></string>
    <!-- Under the target: what the day is for (fork_rep_kind_*), then the Load so far today. -->
    <string name="fork_rep_target_line"><xliff:g id="kind" example="A usual day">%1$s</xliff:g>, <xliff:g id="load" example="11">%2$d</xliff:g> so far</string>
    <string name="fork_rep_target_none">After a week of wear</string>
    <string name="fork_rep_kind_recover">A day to recover</string>
    <string name="fork_rep_kind_moderate">A moderate day</string>
    <string name="fork_rep_kind_usual">A usual day</string>
    <string name="fork_rep_kind_push">A day to push</string>
    <string name="fork_rep_bedtime">Bedtime tonight</string>
    <string name="fork_rep_bedtime_line"><xliff:g id="asleep" example="8 h 25">%1$s</xliff:g> asleep, up at <xliff:g id="wake" example="07:05">%2$s</xliff:g></string>
    <string name="fork_rep_bedtime_line_extra"><xliff:g id="asleep" example="8 h 25">%1$s</xliff:g> asleep, up at <xliff:g id="wake" example="07:05">%2$s</xliff:g>, <xliff:g id="extra" example="25">%3$d</xliff:g> min more for short nights</string>
    <string name="fork_rep_bedtime_none">After a night with its waking</string>

    <!-- The days' Load against each day's own target: the counts, then the stretch before's. -->
    <string name="fork_rep_vs_target">Load against your target</string>
    <string name="fork_rep_within">Within</string>
    <string name="fork_rep_below">Below</string>
    <string name="fork_rep_above">Above</string>
    <string name="fork_rep_vs_target_week">An average week before had <xliff:g id="within" example="3">%1$s</xliff:g> within, <xliff:g id="below" example="4">%2$s</xliff:g> below and <xliff:g id="above" example="0">%3$s</xliff:g> above.</string>
    <string name="fork_rep_vs_target_month">The 30 days before had <xliff:g id="within" example="12">%1$s</xliff:g> within, <xliff:g id="below" example="15">%2$s</xliff:g> below and <xliff:g id="above" example="3">%3$s</xliff:g> above.</string>

    <!-- The stretch against the one before: the card's title, each row's name, and the line under its value. -->
    <string name="fork_rep_compare_week">This week, against the 3 before</string>
