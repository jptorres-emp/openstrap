<?xml version="1.0" encoding="utf-8"?>
<!-- The steps widget's picker preview card (widgets spec 6.4): the edge card's black, lit from the bottom in its ink. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0A0B" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="90" android:type="linear"
                android:startColor="#61C3F53C" android:centerColor="#14C3F53C" android:endColor="#00C3F53C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
