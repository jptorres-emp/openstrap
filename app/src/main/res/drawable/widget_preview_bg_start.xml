<?xml version="1.0" encoding="utf-8"?>
<!-- The start widget's picker preview card (widgets spec 6.4): the edge card's black, lit from the right in its ink. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF0A0A0B" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="180" android:type="linear"
                android:startColor="#61FF5A5F" android:centerColor="#14FF5A5F" android:endColor="#00FF5A5F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</layer-list>
